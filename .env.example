NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgres://orders:orders@localhost:5432/orders
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
REDIS_URL=redis://localhost:6379

# tokens are expected to come from the auth service; `npm run token` mints one for local testing
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_ISSUER=orders-api

WEBHOOK_SECRET=whsec_local_dev_secret

# mailpit from docker-compose, UI on http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Shop <orders@example.com>"

RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000
